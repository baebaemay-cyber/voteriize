rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // เปลี่ยนอีเมลเป็นอีเมลแอดมินจริง (ใส่ได้หลายอัน)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_ADMIN_EMAIL@example.com'];
    }
    // ข้อมูลที่แสดงหน้าเว็บ (เปอร์เซ็นต์ MAMA / ส่วนต่าง MMA) ทุกคนอ่านได้
    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // ยอดโหวตจริงและรายชื่อทั้งหมด แอดมินเท่านั้น
    match /private/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
